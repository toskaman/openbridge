<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="10dp" android:background="@drawable/widget_bg">
    <TextView android:id="@+id/w_state" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Glasses" android:textColor="#ECF0FF" android:textSize="14sp" android:paddingBottom="8dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/w_back" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp"
            android:text="Back" android:textColor="#ECF0FF" android:textAllCaps="false" android:background="@drawable/widget_btn" android:layout_marginEnd="4dp" />
        <Button android:id="@+id/w_ok" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp"
            android:text="Open" android:textColor="#ECF0FF" android:textAllCaps="false" android:background="@drawable/widget_btn" android:layout_marginEnd="4dp" />
        <Button android:id="@+id/w_next" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp"
            android:text="Next" android:textColor="#ECF0FF" android:textAllCaps="false" android:background="@drawable/widget_btn" android:layout_marginEnd="4dp" />
        <Button android:id="@+id/w_oracle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp"
            android:text="Oracle" android:textColor="#060812" android:textAllCaps="false" android:background="@drawable/widget_btn_primary" />
    </LinearLayout>
</LinearLayout>

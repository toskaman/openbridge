{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openbridge:b2/skill_routes/2",
  "title": "OpenBridge B2 skill route truth (rev 2)",
  "description": "GET /api/v2/skill_routes?skill= response, and the POST /api/v2/skill_invoke request. Cross-field rules live in src/runtime/route_contract.py:semantic_errors (shared by backend and UI tests).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "server_time", "graph_revision", "skill", "policy", "selected_route_id", "selection", "invocation", "routes", "delivery"],
  "properties": {
    "schema_version": {"const": "b2.2"},
    "server_time": {"$ref": "#/$defs/ts"},
    "graph_revision": {
      "type": "object", "additionalProperties": false, "required": ["epoch", "seq"],
      "properties": {
        "epoch": {"type": "string", "pattern": "^[a-z0-9-]{4,40}$"},
        "seq": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
      }
    },
    "skill": {
      "type": "object", "additionalProperties": false,
      "required": ["skill_id", "version", "reversibility", "idempotent", "consent"],
      "properties": {
        "skill_id": {"$ref": "#/$defs/skill_id"},
        "version": {"type": "integer", "minimum": 1, "maximum": 1000},
        "reversibility": {"enum": ["NONE", "EXACT", "SESSION_CLEANUP", "IRREVERSIBLE"]},
        "idempotent": {"type": "boolean"},
        "consent": {"enum": ["none", "per_invocation"]}
      }
    },
    "policy": {
      "type": "object", "additionalProperties": false, "required": ["mode", "failover", "pinned_route_id", "set_by"],
      "properties": {
        "mode": {"enum": ["PINNED", "PREFERRED", "AUTO"]},
        "failover": {"enum": ["none", "idempotent_read_retry"]},
        "pinned_route_id": {"type": ["string", "null"], "pattern": "^rt-[0-9a-f]{16}$"},
        "set_by": {"enum": ["owner", "default"]}
      }
    },
    "selected_route_id": {"type": ["string", "null"], "pattern": "^rt-[0-9a-f]{16}$"},
    "selection": {
      "type": "object", "additionalProperties": false, "required": ["rule", "decided_at"],
      "properties": {
        "rule": {"enum": ["pinned", "preferred_order", "auto_score", "none_eligible"]},
        "decided_at": {"$ref": "#/$defs/ts"}
      }
    },
    "invocation": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "invocation_id", "route_id", "lease_id", "lease_expires_at", "lease_expires_in_s"],
      "properties": {
        "status": {"enum": ["idle", "armed", "executing"]},
        "invocation_id": {"type": ["string", "null"], "pattern": "^inv-[0-9a-f]{32}$"},
        "route_id": {"type": ["string", "null"], "pattern": "^rt-[0-9a-f]{16}$"},
        "lease_id": {"type": ["string", "null"], "pattern": "^ls-[0-9a-f]{16}$"},
        "lease_expires_at": {"$ref": "#/$defs/ts_or_null"},
        "lease_expires_in_s": {"type": ["integer", "null"], "minimum": 0, "maximum": 30}
      }
    },
    "routes": {"type": "array", "minItems": 0, "maxItems": 32, "items": {"$ref": "#/$defs/route"}},
    "delivery": {
      "type": "object", "additionalProperties": false, "required": ["mode", "poll_after_s", "events_since"],
      "properties": {
        "mode": {"const": "poll"},
        "poll_after_s": {"type": "integer", "minimum": 1, "maximum": 30},
        "events_since": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
      }
    }
  },
  "$defs": {
    "ts": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"},
    "ts_or_null": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"},
    "skill_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,47}$"},
    "device_key": {"type": "string", "minLength": 1, "maxLength": 64},
    "grant": {"enum": ["observe", "read", "control"]},
    "evidence": {"enum": ["REAL_HARDWARE", "SIMULATED", "NONE"]},
    "reason": {"enum": ["link_down", "grant_insufficient", "consent_missing", "capability_absent", "lease_stale", "dependency_unready", "policy_blocked", "backend_unknown"]},
    "hop": {
      "type": "object", "additionalProperties": false,
      "required": ["device_key", "transport", "primitive_id", "grant", "required_grant"],
      "properties": {
        "device_key": {"$ref": "#/$defs/device_key"},
        "transport": {"enum": ["USB", "WIFI", "LAN", "BLE", "RELAY", "CLOUD_API", "AGENT"]},
        "primitive_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,40}$"},
        "grant": {"$ref": "#/$defs/grant"},
        "required_grant": {"$ref": "#/$defs/grant"}
      }
    },
    "route": {
      "type": "object", "additionalProperties": false,
      "required": ["route_id", "provider_id", "operation_id", "state", "reason", "reason_detail", "consent", "hops", "authority", "freshness", "exactness", "last_receipt", "evidence"],
      "properties": {
        "route_id": {"type": "string", "pattern": "^rt-[0-9a-f]{16}$"},
        "provider_id": {"type": "string", "pattern": "^pv-[0-9a-f]{16}$"},
        "operation_id": {"type": "string", "pattern": "^op:[a-z_]+(:[a-z0-9_]+)?$"},
        "state": {"enum": ["READY", "STANDBY", "UNAVAILABLE"]},
        "reason": {"type": ["string", "null"], "enum": ["link_down", "grant_insufficient", "consent_missing", "capability_absent", "lease_stale", "dependency_unready", "policy_blocked", "backend_unknown", null]},
        "reason_detail": {
          "type": ["object", "null"], "additionalProperties": false, "required": ["missing_grant", "hop_index", "blocking_device_key"],
          "properties": {
            "missing_grant": {"type": ["string", "null"], "enum": ["observe", "read", "control", null]},
            "hop_index": {"type": ["integer", "null"], "minimum": 0, "maximum": 3},
            "blocking_device_key": {"type": ["string", "null"], "maxLength": 64}
          }
        },
        "consent": {"enum": ["none", "required", "armed"]},
        "hops": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"$ref": "#/$defs/hop"}},
        "authority": {
          "type": "object", "additionalProperties": false, "required": ["grants_checked", "authority_rev"],
          "properties": {
            "grants_checked": {"type": "array", "maxItems": 8, "items": {"type": "string", "maxLength": 96}},
            "authority_rev": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
          }
        },
        "freshness": {
          "type": "object", "additionalProperties": false, "required": ["observed_at", "expires_at", "lease_s", "source"],
          "properties": {
            "observed_at": {"$ref": "#/$defs/ts"},
            "expires_at": {"$ref": "#/$defs/ts"},
            "lease_s": {"type": "integer", "minimum": 1, "maximum": 3600},
            "source": {"type": "string", "maxLength": 64}
          }
        },
        "exactness": {
          "type": ["object", "null"], "additionalProperties": false, "required": ["range", "before_snapshot", "readback", "restore"],
          "properties": {
            "range": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 0, "maximum": 100000}},
            "before_snapshot": {"const": true},
            "readback": {"const": "independent"},
            "restore": {"const": "exact"}
          }
        },
        "last_receipt": {
          "type": ["object", "null"], "additionalProperties": false, "required": ["transaction_id", "state", "evidence", "finished_at"],
          "properties": {
            "transaction_id": {"type": "string", "pattern": "^tx-[0-9a-f]{16}$"},
            "state": {"enum": ["VERIFIED", "EXECUTED", "REVERTED", "FAILED", "PARTIAL", "UNKNOWN_TIMEOUT", "BLOCKED"]},
            "evidence": {"$ref": "#/$defs/evidence"},
            "finished_at": {"$ref": "#/$defs/ts"}
          }
        },
        "evidence": {"$ref": "#/$defs/evidence"}
      }
    },
    "invoke_request": {
      "type": "object", "additionalProperties": false,
      "required": ["invocation_id", "skill_id", "route_id", "lease_id", "graph_revision", "params", "consent"],
      "properties": {
        "invocation_id": {"type": "string", "pattern": "^inv-[0-9a-f]{32}$"},
        "skill_id": {"$ref": "#/$defs/skill_id"},
        "route_id": {"type": "string", "pattern": "^rt-[0-9a-f]{16}$"},
        "lease_id": {"type": "string", "pattern": "^ls-[0-9a-f]{16}$"},
        "graph_revision": {
          "type": "object", "additionalProperties": false, "required": ["epoch", "seq"],
          "properties": {"epoch": {"type": "string", "pattern": "^[a-z0-9-]{4,40}$"}, "seq": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}}
        },
        "params": {"type": "object"},
        "consent": {"type": "boolean"}
      }
    }
  }
}
